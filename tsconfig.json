{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/assets/*": [
        "./src/assets/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/layouts/*": [
        "./src/layouts/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ],
      "@/scripts/*": [
        "./src/scripts/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    ".vscode",
    "dist"
  ]
}