---
import vicePresidents from "@/settings/vicePresidents.json";
import presidents from "@/settings/presidents.json";
import directors from "@/settings/directors.json";

import Base from "@/layouts/BaseWide.astro";
import TeamGrid from "@/components/TeamGrid.astro";
import Title from "@/components/Title.astro";
---

<Base title="About">
    <Title>Campaigning for You</Title>
    <div class="pb-12 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <TeamGrid {...presidents} /> 
        <TeamGrid {...vicePresidents} />
        <TeamGrid {...directors} />
    </div>
</Base>