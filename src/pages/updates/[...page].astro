---
import type { CollectionEntry } from "astro:content";
import { getAllPosts, getPostSortDate, sortMDByDate } from "../../data/post";
import PageLayout from "../../layouts/Base.astro";
import { formatRailDate } from "../../utils/date";
import { withBase } from "../../utils/path";
import type { GetStaticPaths, Page } from "astro";
import Title from "../../components/Title.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 1000;
	const allPosts = await getAllPosts();
	const allPostsByDate = sortMDByDate(allPosts);
	return paginate(allPostsByDate, { pageSize: MAX_POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"updates">>;
}

const { page } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next →",
			url: page.url.next,
		},
	}),
};

const totalCount = page.total;
---

<PageLayout description={meta.description} title={meta.title}>
	<Title>Scoping for Updates</Title>
	<section class="writing" aria-labelledby="writing-label">
		<div class="section-label" id="writing-label">Updates · {totalCount} posts</div>
		<div class="timeline">
			{
				page.data.map((p, idx) => (
					<a
						class="post"
						data-astro-prefetch
						href={withBase(`/updates/${p.id}/`)}
						style={`--i: ${idx}`}
					>
						<div class="post-rail">
							<time class="post-date" datetime={getPostSortDate(p).toISOString()}>
								{formatRailDate(getPostSortDate(p))}
							</time>
							<span class="post-dot" aria-hidden="true" />
						</div>
						<div class="post-body">
							<h2 class="post-title">{p.data.title}</h2>
							<p class="post-preview">{p.data.description}</p>
						</div>
					</a>
				))
			}
		</div>
		{
			(paginationProps.prevUrl || paginationProps.nextUrl) && (
				<nav class="pagination" aria-label="Pagination">
					{paginationProps.prevUrl && (
						<a class="pag-link prev" data-astro-prefetch href={paginationProps.prevUrl.url}>
							{paginationProps.prevUrl.text}
						</a>
					)}
					{paginationProps.nextUrl && (
						<a class="pag-link next" data-astro-prefetch href={paginationProps.nextUrl.url}>
							{paginationProps.nextUrl.text}
						</a>
					)}
				</nav>
			)
		}
	</section>
</PageLayout>

<style>
	.writing {
		margin-bottom: 96px;
	}

	.section-label {
		font-family: var(--font-sans);
		font-size: 11.5px;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #a3a3a3; 
		margin-bottom: 36px;
	}

	.timeline {
		display: grid;
		grid-template-columns: 110px 1fr; 
		column-gap: 36px; 
		position: relative;
	}
	.timeline::before {
		content: "";
		position: absolute;
		left: calc(110px - 0.5px);
		top: 6px;
		bottom: 6px;
		width: 1px;
		background-color: #262626;
		transition: background-color 0.35s ease;
	}
	
	/* --- Post Items --- */
	.timeline > .post {
		display: contents;
		-webkit-tap-highlight-color: transparent;
		transition-property: color, background-color, border-color, transform, opacity;
		transition-duration: 0.18s;
		transition-timing-function: ease;
		text-decoration: none;
	}
	.timeline > .post:active {
		transform: scale(0.992);
		opacity: 0.85;
	}

	.timeline .post-rail {
		position: relative;
		--rail-pad-top: 4px;
		--rail-date-size: 11.5px;
		--rail-date-lh: 1.4;
		padding-top: var(--rail-pad-top);
		padding-right: 18px;
		text-align: right;
	}
	.timeline .post-date {
		font-family: var(--font-mono);
		font-size: var(--rail-date-size);
		color: #a3a3a3; /* neutral-400 */
		letter-spacing: -0.01em;
		line-height: var(--rail-date-lh);
		white-space: nowrap;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		font-feature-settings: "tnum";
		transition: color 0.2s ease;
	}
	.timeline .post-dot {
		--rail-dot-size: 9px;
		position: absolute;
		right: calc(-0.5 * var(--rail-dot-size));
		top: calc(var(--rail-pad-top) + 0.5lh);
		font-size: var(--rail-date-size);
		line-height: var(--rail-date-lh);
		transform: translateY(-50%);
		width: var(--rail-dot-size);
		height: var(--rail-dot-size);
		border-radius: 50%;
		background: #000000; 
		border: 1.5px solid #404040; 
		transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
		z-index: 1;
	}
	.timeline .post-body {
		padding-bottom: 38px;
	}
	.timeline .post-title {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 18.5px;
		color: #e5e5e5; 
		line-height: 1.3;
		letter-spacing: -0.012em;
		margin: 0 0 6px;
		text-wrap: balance;
		word-wrap: break-word;
		overflow-wrap: anywhere;
		transition: color 0.2s ease;
	}
	.timeline .post-preview {
		font-size: 16px;
		line-height: 1.55;
		color: #a3a3a3; /* neutral-400 */
		margin: 0;
		word-wrap: break-word;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* --- Hover & Focus States --- */
	.timeline .post:hover .post-title {
		color: #8b5cf6; /* violet-500 */
	}
	.timeline .post:hover .post-dot {
		border-color: #8b5cf6;
		background: #8b5cf6;
		box-shadow: 0 0 0 3px #000000;
	}
	.timeline .post:hover .post-date {
		color: #737373; /* neutral-500 */
	}
	.timeline .post:focus-visible {
		outline: 2px solid #8b5cf6;
		outline-offset: 4px;
		border-radius: 4px;
	}

	/* --- Pagination --- */
	.pagination {
		grid-column: 2;
		margin-top: 8px;
		display: flex;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
	}
	.pag-link {
		display: inline-block;
		padding: 8px 4px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #a3a3a3;
		text-decoration: underline;
		text-decoration-color: rgba(163, 163, 163, 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease, opacity 0.18s ease;
	}
	.pag-link:active {
		opacity: 0.7;
	}
	.pag-link.prev {
		margin-right: auto;
	}
	.pag-link.next {
		margin-left: auto;
	}
	.pag-link:hover {
		color: #8b5cf6;
		text-decoration-color: #8b5cf6;
	}
	.pag-link:focus-visible {
		outline: 2px solid #8b5cf6;
		outline-offset: 3px;
		border-radius: 3px;
	}

	/* --- Stagger Animations --- */
	@media (prefers-reduced-motion: no-preference) {
		@keyframes intro-fade-up {
			from { opacity: 0; transform: translateY(6px); }
			to   { opacity: 1; transform: none; }
		}
		.timeline > .post .post-rail,
		.timeline > .post .post-body,
		.timeline > .pagination,
		.section-label {
			animation: intro-fade-up 380ms cubic-bezier(0.2, 0.6, 0.2, 1) both;
			animation-delay: calc(var(--i, 0) * 55ms);
		}
	}

	/* --- Media Queries --- */
	@media (max-width: 720px) {
		.timeline {
			display: block;
		}
		.timeline::before {
			display: none;
		}
		.timeline > .post {
			display: block;
			padding-bottom: 32px;
		}
		.timeline .post-rail {
			text-align: left;
			padding: 0 0 6px 0;
		}
		.timeline .post-dot {
			display: none;
		}
		.timeline .post-body {
			padding-bottom: 0;
		}
		.pagination {
			margin-top: 16px;
		}
	}

	@media (max-width: 420px) {
		.writing {
			margin-bottom: 64px;
		}
		.section-label {
			margin-bottom: 26px;
		}
		.timeline .post-title {
			font-size: 17px;
		}
		.timeline .post-preview {
			font-size: 15px;
		}
		.timeline .post-date {
			font-size: 11px;
		}
	}
</style>