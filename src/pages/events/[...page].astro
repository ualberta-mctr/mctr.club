---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { CalendarDays, MapPin, CalendarClock } from "lucide-astro";
import PageLayout from "../../layouts/BaseWide.astro";
import { withBase } from "../../utils/path";
import type { GetStaticPaths, Page } from "astro";
import PublicCalendar from "../../components/PublicCalendar.astro";
import Title from "../../components/Title.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_EVENTS_PER_PAGE = 24; 
	const allEvents = await getCollection("events");
	
	const sortedEvents = allEvents.sort(
		(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
	);

	return paginate(sortedEvents, { pageSize: MAX_EVENTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"events">>;
}

const { page } = Astro.props;

const allEventsForTags = await getCollection("events");
const uniqueTags = [...new Set(allEventsForTags.flatMap(e => e.data.tags || []))].sort();

const meta = {
	description: "Browse our upcoming and past events",
	title: "Events",
};

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← Previous", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Next →", url: page.url.next } }),
};

const today = new Date();
today.setHours(0, 0, 0, 0);
---

<PageLayout description={meta.description} title={meta.title}>
	<Title>Navigating for Events</Title>
	<Section>Calendar</Section>
	<PublicCalendar 
		calendarId="c_6564419f02ef431b3ac7a293c92799c6288beefbea2c0d260c57a695b1a31af2@group.calendar.google.com" 
		viewMode="month" 
	/>
    <div class="flex flex-wrap items-center justify-center gap-4 w-full pb-4">
        <Button href="https://calendar.google.com/calendar/render?cid=c_6564419f02ef431b3ac7a293c92799c6288beefbea2c0d260c57a695b1a31af2@group.calendar.google.com" target="_blank">Add to calendar</Button>
    </div>
	<section class="events-section w-full mb-20">
		<Section>List</Section>
		{uniqueTags.length > 0 && (
			<div class="flex flex-wrap justify-center gap-2 mb-10 max-w-4xl mx-auto px-4" id="tag-filters">
				<button 
					class="filter-btn flex items-center justify-center px-4 py-1.5 rounded-lg text-[11.5px] font-bold font-sans tracking-widest capitalize leading-none transition-all duration-300 border border-[#1c1c27] bg-[#1c1c27] text-violet-500"
					data-tag="all"
				>
					All
				</button>
				{uniqueTags.map(tag => (
					<button 
						class="filter-btn flex items-center justify-center px-4 py-1.5 rounded-lg text-[11.5px] font-bold font-sans tracking-widest capitalize leading-none transition-all duration-300 border border-[#1c1c27] bg-[#0e0e16]/80 backdrop-blur-xl text-gray-400 hover:bg-[#1c1c27] hover:text-violet-500"
						data-tag={tag}
					>
						{tag}
					</button>
				))}
			</div>
		)}

		<div class="flex flex-wrap items-stretch justify-center gap-5 xl:gap-6 max-w-[1600px] mx-auto w-full px-4 sm:px-6" id="event-grid">
					{
						page.data.map((event) => {
							const eventDate = new Date(event.data.date);
							
							const isPast = eventDate.valueOf() < today.valueOf();

							const formattedDate = eventDate.toLocaleDateString("en-CA", {
								year: "numeric", 
								month: "short", 
								day: "numeric",
								timeZone: "UTC",
							});

							const eventTags = event.data.tags || [];
							const displayTags = isPast ? ["Past", ...eventTags] : eventTags;
							const cardTagData = eventTags.join(",");

							return (
								<a
									href={withBase(`/events/${event.id}/`)}
									class="event-card group relative p-1.5 pb-2.5 w-full sm:w-[220px] md:w-[240px] rounded-2xl bg-[#0e0e16]/80 backdrop-blur-xl border border-white/10 shadow-[0_0_20px_rgba(255,255,255,0.03)] transition-all duration-300 flex flex-col cursor-pointer hover:border-violet-500/40 hover:shadow-[0_0_30px_rgba(139,92,246,0.1)] no-underline"
									data-tags={cardTagData}
								>
							<div class="relative w-full aspect-[3/4] shrink-0 overflow-hidden rounded-xl border border-white/5 bg-neutral-900">
								
								{displayTags.length > 0 && (
									<div class="absolute top-2 left-2 right-2 flex flex-wrap gap-1.5 z-10 pointer-events-none">
										{displayTags.map(tag => (
											<span class={`px-2 py-0.5 rounded-md text-[9.5px] font-bold font-sans capitalize tracking-wider ${tag === 'Past' ? 'bg-neutral-800 text-neutral-300 border border-neutral-700' : 'bg-violet-400 text-white border border-violet-400'}`}>
												{tag}
											</span>
										))}
									</div>
								)}

								{event.data.coverImage ? (
									<Image
										src={event.data.coverImage.src}
										alt={event.data.coverImage.alt}
										width={480}
										format="webp"
										class={`absolute inset-0 h-full w-full object-cover object-center transition-all duration-500 group-hover:scale-105 ${isPast ? 'grayscale group-hover:grayscale-0' : ''}`}
									/>
								) : (
									<div class="absolute inset-0 flex items-center justify-center">
										<CalendarDays class="w-24 h-24 text-neutral-800 transition-transform duration-500 group-hover:scale-110 group-hover:text-violet-500/30" strokeWidth={1.5} />
									</div>
								)}
							</div>

							<div class="flex flex-col flex-grow pt-3 px-2 text-center overflow-hidden">
								
								<div class="flex-grow flex items-center justify-center mb-2 w-full">
									<h2 class="text-white font-serif font-bold text-[16px] leading-tight tracking-wide group-hover:text-violet-300 transition-colors duration-300 m-0 w-full line-clamp-2">
										{event.data.name}
									</h2>
								</div>
								
								<div class="mt-auto flex flex-row items-center justify-center gap-1.5 text-[9.5px] font-bold text-violet-400 tracking-widest uppercase font-sans w-full">
									
									<div class="flex items-center gap-1 min-w-0 flex-shrink">
										<MapPin class="w-3 h-3 opacity-80 flex-shrink-0" />
										<span class="truncate">{event.data.location}</span>
									</div>
									
									<span class="opacity-50 flex-shrink-0">&middot;</span>
									
									<time class="flex items-center gap-1 flex-shrink-0" datetime={event.data.date}>
										<CalendarClock class="w-3 h-3 opacity-80 flex-shrink-0" />
										<span class="whitespace-nowrap">{formattedDate}</span>
									</time>

								</div>
							</div>
						</a>
					);
				})
			}
		</div>

		{
			(paginationProps.prevUrl || paginationProps.nextUrl) && (
				<nav class="pagination max-w-[1550px] mx-auto px-6 mt-16 flex items-center justify-between" aria-label="Pagination">
					{paginationProps.prevUrl && (
						<a class="pag-link prev mr-auto" href={paginationProps.prevUrl.url}>
							{paginationProps.prevUrl.text}
						</a>
					)}
					{paginationProps.nextUrl && (
						<a class="pag-link next ml-auto" href={paginationProps.nextUrl.url}>
							{paginationProps.nextUrl.text}
						</a>
					)}
				</nav>
			)
		}
	</section>
</PageLayout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const filterBtns = document.querySelectorAll('.filter-btn');
		const cards = document.querySelectorAll('.event-card');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				filterBtns.forEach(b => {
					b.classList.remove('bg-[#1c1c27]', 'text-violet-500');
					b.classList.add('bg-[#0e0e16]/80', 'backdrop-blur-xl', 'text-gray-400', 'hover:bg-[#1c1c27]', 'hover:text-violet-500');
				});
				btn.classList.remove('bg-[#0e0e16]/80', 'backdrop-blur-xl', 'text-gray-400', 'hover:bg-[#1c1c27]', 'hover:text-violet-500');
				btn.classList.add('bg-[#1c1c27]', 'text-violet-500');

				const selectedTag = btn.getAttribute('data-tag');

				cards.forEach(card => {
					const htmlCard = card as HTMLElement;
					if (selectedTag === 'all') {
						htmlCard.style.display = 'flex';
					} else {
						const cardTags = htmlCard.getAttribute('data-tags')?.split(',') || [];
						if (selectedTag && cardTags.includes(selectedTag)) {
							htmlCard.style.display = 'flex';
						} else {
							htmlCard.style.display = 'none';
						}
					}
				});
			});
		});
	});
</script>

<style>
	.pag-link {
		display: inline-block;
		padding: 8px 4px;
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #a3a3a3;
		text-decoration: underline;
		text-decoration-color: rgba(163, 163, 163, 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease, opacity 0.18s ease;
	}
	.pag-link:hover {
		color: #8b5cf6;
		text-decoration-color: #8b5cf6;
	}
</style>