---
import ResourceGrid from "@/components/ResourceGrid.astro";
import Base from "@/layouts/BaseWide.astro";

import resourcesData from "@/settings/resources.json";
import Title from "@/components/Title.astro";
---

<Base title="Resources">
  <Title>Spelunking for Resources</Title>
  <div class="pb-12 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <ResourceGrid title="Resources" resources={resourcesData} />
  </div>
</Base>
