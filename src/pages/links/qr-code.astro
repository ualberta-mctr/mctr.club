---
import '@/styles/global.css';
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Fluid from '@/components/Fluid.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = "Link in Bio QR", description = "Home of UAlberta Mechatronics" } = Astro.props;
---

<html lang="en" class="dark font-serif bg-black text-neutral-400 scroll-smooth">
	<head>
		<BaseHead description={description} title={title} />
	</head>
	<body>
		<SkipLink />
		<Fluid />
        <main id="main" class="min-h-screen max-w-3xl mx-auto flex flex-col items-center justify-center px-6">
            <div class="p-4 bg-[#0e0e16]/80 backdrop-blur-xl border border-white/10 shadow-[0_0_20px_rgba(255,255,255,0.03)] rounded-2xl">
                <img 
                    src="/qr-code.png" 
                    alt="QR Code" 
                    width="300"
                    height="300"
                    class="rounded-xl block" 
                />
            </div>
		</main>
	</body>
</html>