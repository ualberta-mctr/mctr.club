---
import Container from './Container.astro';
import Logo from './Logo.astro';

const columns = [
  {
    title: 'Contact',
    links: [
      { label: 'Instagram', href: 'https://www.instagram.com/mctr_ualberta/' },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/company/mctrclub/' },
      { label: 'Email', href: 'mailto:mctrclub@ualberta.ca' },
    ],
  },
  {
    title: 'Information',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Resources', href: '/resources' },
      { label: 'Updates', href: '/updates' },
    ]
  }
];
---

<footer class="border-t border-line bg-[#0e0e16]/80 backdrop-blur-xl  border-neutral-700 font-">
  <Container class="py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-fg-3">
          Home of mechatronics students est. 2025
        </p>
      </div>
      {
        columns.map(({ title, links }) => (
          <nav aria-label={title}>
            <p class="text-[13px] font-semibold tracking-wide text-fg">{title}</p>
            <ul class="mt-4 space-y-2.5">
              {links.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-sm text-fg-2 transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-line pt-6 sm:flex-row sm:items-center border-neutral-700">
      <p class="text-[13px] text-fg-3">{new Date().getFullYear()} Mechatronics and Robotics Engineering Club © All rights reserved.</p>
      <p class="text-[13px] text-fg-3">
        Contribute! — <a href="https://github.com/ualberta-mctr" class="text-fg-2 underline decoration-line-2 underline-offset-[3px] transition-colors hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">Github</a>
      </p>
    </div>
  </Container>
</footer>