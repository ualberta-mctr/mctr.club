---
interface Props {
  // Allows you to pass additional Tailwind classes when using the component
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    // Base layout and padding
    "relative w-full max-w-md p-6 sm:p-8",
    
    // Rounded edges
    "rounded-2xl",
    
    // Frosted glass background (dark grayish-blue with opacity and blur)
    "bg-[#1c1f2e]/80 backdrop-blur-xl",
    
    // Glowing border effect (subtle white border with an outer shadow glow)
    "border border-white/10",
    "shadow-[0_0_20px_rgba(255,255,255,0.03)]",
    
    // Custom classes passed via props
    className,
  ]}
>
  <slot />
</div>