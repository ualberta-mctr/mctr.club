---
const { name, bio, avatar } = Astro.props;
const baseUrl = import.meta.env.BASE_URL

const avatarSrc = avatar 
  ? `${baseUrl}/${avatar}`
  : `${baseUrl}/favicon.svg`;

---

<header class="mt-4 mb-12 mx-auto max-w-prose w-full">
    <a href={import.meta.env.BASE_URL || './'} class="block group">
      <div>
        <h1 class="font-bold text-gray-100 text-lg group-hover:text-violet-500 transition-colors">{ name }</h1>
        {bio && <p class="text-gray-400">{bio}</p>}
      </div>
    </a>
</header>