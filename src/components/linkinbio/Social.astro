---
import {
  Twitter,
  Linkedin,
  Instagram,
  Facebook,
  Youtube,
  Twitch,
  Github,
  Gitlab,
  Dribbble,
  Mail,
  QrCode,
  Link as LinkIcon
} from 'lucide-astro';

const { social, align } = Astro.props;

const activeSocial = Object.entries(social).filter(([_, url]) => url && url !== '');

const socialIcons: Record<string, any> = {
  twitter: Twitter,
  x: Twitter, 
  linkedin: Linkedin,
  instagram: Instagram,
  facebook: Facebook,
  youtube: Youtube,
  twitch: Twitch,
  github: Github,
  gitlab: Gitlab,
  dribbble: Dribbble,
  email: Mail,
  qrcode: QrCode,
};

let listClasses = 'flex items-center flex-wrap gap-2 text-base';

if (align === 'center') {
  listClasses = listClasses + ' justify-center';
}
---

{activeSocial.length > 0 && (
  <ul class={listClasses}>
    {activeSocial.map(([platform, url]) => {
      const key = platform.toLowerCase();
      const IconComponent = socialIcons[key] || LinkIcon;

      if (key === 'qrcode') {
        return (
          <li>
            <a
              class="inline-grid place-items-center w-9 h-9 border border-[#1c1c27] rounded-md bg-[#1c1c27] text-gray-100 hover:bg-[#252531] hover:text-violet-500 transition-colors"
              href="/links/qr-code"
              aria-label="View QR Code"
              title="View QR Code"
            >
              <IconComponent class="w-[18px] h-[18px]" stroke-width={2} />
            </a>
          </li>
        )
      }

      return (
        <li>
          <a
            class="inline-grid place-items-center w-9 h-9 border border-[#1c1c27] rounded-md bg-[#1c1c27] text-gray-100 hover:bg-[#252531] hover:text-violet-500 transition-colors"
            href={url as string}
            aria-label={platform}
            target="_blank"
            rel="noopener noreferrer"
          >
            <IconComponent class="w-[18px] h-[18px]" stroke-width={2} />
          </a>
        </li>
      );
    })}
  </ul>
)}