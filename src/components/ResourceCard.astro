---
import * as Icons from 'lucide-astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  link: string;
}

const { icon, title, description, link } = Astro.props;

const formattedIconName = icon
  .split('-')
  .map(word => word.charAt(0).toUpperCase() + word.slice(1))
  .join('');


const IconComponent = (Icons as Record<string, any>)[formattedIconName] || Icons.Box;
---

<a 
  href={link}
  rel="noopener noreferrer"
  class="group relative flex flex-col justify-between p-6 sm:p-8 h-full rounded-2xl bg-[#0e0e16]/80 backdrop-blur-xl border border-white/10 shadow-[0_0_20px_rgba(255,255,255,0.03)] transition-all duration-300 hover:border-violet-500/40 hover:shadow-[0_0_30px_rgba(139,92,246,0.1)] hover:-translate-y-1"
>
  <div>
    <div class="w-10 h-10 rounded-lg bg-neutral-900/80 border border-white/5 flex items-center justify-center mb-6 transition-colors duration-300 group-hover:border-violet-500/30 group-hover:bg-violet-500/10">
      <IconComponent class="w-5 h-5 text-violet-400 transition-transform duration-300 group-hover:scale-110" strokeWidth={1.75} />
    </div>

    <h3 class="text-lg font-bold text-white tracking-wide font-serif mb-2 transition-colors duration-300 group-hover:text-violet-200">
      {title}
    </h3>

    <p class="text-sm text-neutral-300 font-sans leading-relaxed">
      {description}
    </p>
  </div>

  <div class="absolute bottom-0 left-6 right-6 h-[2px] bg-gradient-to-r from-transparent via-violet-500/0 to-transparent transition-all duration-500 group-hover:via-violet-500/40"></div>
</a>