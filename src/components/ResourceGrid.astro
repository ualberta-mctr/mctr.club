---
import ResourceCard from './ResourceCard.astro';
import Section from './Section.astro';

interface Resource {
  icon: string;
  title: string;
  description: string;
  link: string;
}

interface Props {
  title?: string;
  resources: Resource[];
}

const { title, resources } = Astro.props;
---

<div class="w-full mb-20 last:mb-0">
  
  {title && (
    <Section>{title}</Section>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 xl:gap-8 max-w-[1550px] mx-auto w-full px-4 sm:px-6">
    {resources.map((item) => (
      <ResourceCard 
        icon={item.icon}
        title={item.title}
        description={item.description}
        link={item.link}
      />
    ))}
  </div>
  
</div>