---
import "@schedule-x/theme-default/dist/index.css";

export interface Props {
  endpoint?: string;
  viewMode?: "week" | "month";
  calendarId?: string;
}

const { 
  endpoint = "/api/google-calendar-events", 
  viewMode = "week",
  calendarId 
} = Astro.props;
---

<div class="calendar-wrapper">
  <div 
    id="schedule-x-calendar" 
    data-endpoint={endpoint}
    data-view-mode={viewMode}
    data-calendar-id={calendarId}
  >
    <div class="calendar-loading">Loading calendar...</div>
  </div>
</div>

<style>
  .calendar-wrapper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
    font-family: var(--font-sans), system-ui, sans-serif;
  }

  #schedule-x-calendar {
    position: relative;
    width: 100%;
    height: 500px;
    border-radius: 1rem; /* rounded-2xl */
    background-color: rgba(14, 14, 22, 0.8); /* bg-[#0e0e16]/80 */
    backdrop-filter: blur(24px); /* backdrop-blur-xl */
    border: 1px solid rgba(255, 255, 255, 0.1); /* border-white/10 */
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.03); /* custom white shadow glow */
    overflow: hidden;

    --sx-border: rgba(255, 255, 255, 0.1) !important;
    --sx-color-outline: rgba(255, 255, 255, 0.1); /* Border line matching border-white/10 */
    --sx-color-outline-variant: rgba(255, 255, 255, 0.1);
    
    --sx-color-primary: #a78bfa; /* violet-400 */
    --sx-color-on-primary: #0e0e16; 
    --sx-color-primary-container: rgba(167, 139, 250, 0.15); 
    --sx-color-on-primary-container: #a78bfa; 
    
    --sx-color-secondary: #9ca3af; /* gray-400 */
    --sx-color-on-secondary: #ffffff;
    
    --sx-color-surface: transparent; 
    --sx-color-surface-dim: rgba(14, 14, 22, 0.6);
    --sx-color-surface-bright: rgba(255, 255, 255, 0.05);
    --sx-color-on-surface: #ffffff; /* primary text (white) */
    
    --sx-color-surface-container: rgba(255, 255, 255, 0.02);
    --sx-color-surface-container-low: rgba(255, 255, 255, 0.01);
    --sx-color-surface-container-high: rgba(255, 255, 255, 0.06);
    
    --sx-color-background: transparent;
    --sx-color-on-background: #ffffff;
    
    --sx-color-shadow: rgba(255, 255, 255, 0.03); 
    --sx-color-surface-tint: #a78bfa;
    --sx-color-neutral: #9ca3af; /* secondary text (gray-400) */
    --sx-color-neutral-variant: rgba(255, 255, 255, 0.3);
    
    --sx-internal-color-gray-ripple-background: rgba(255, 255, 255, 0.1);
    --sx-internal-color-light-gray: rgba(255, 255, 255, 0.02);
    --sx-internal-color-text: #ffffff;
  }

  /* --- Precise Grid Internal Borders Style Adjustment --- */
  :global(.sx__month-grid-day),
  :global(.sx__month-grid-day-name),
  :global(.sx__week-grid__day),
  :global(.sx__time-grid-day) {
    border-right: 1px solid rgba(255, 255, 255, 0.05) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
  }

  :global(.sx__range-heading),
  :global(.sx__event-title),
  :global(.sx__event-modal__title),
  :global(.sx__event-modal-title),
  :global(.sx__month-grid-day-number) {
    font-family: var(--font-serif) !important;
  }

  #schedule-x-calendar,
  :global(.sx__time-max-width),
  :global(.sx__week-grid__day-header),
  :global(.sx__today-button),
  :global(.sx__month-grid-day-name),
  :global(.sx__event-modal-description),
  :global(.sx__event-modal) {
    font-family: var(--font-sans) !important;
  }

  .calendar-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #a78bfa; 
    font-family: var(--font-sans), monospace;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(14, 14, 22, 0.4);
    border-radius: 1rem;
  }

  :global(.sx__calendar-header) {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 0.75rem 1rem 0.5rem 1rem;
    background-color: rgba(14, 14, 22, 0.4) !important;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global(.sx__view-selection),
  :global(.sx__date-picker-wrapper) {
    display: none !important;
  }

  :global(.sx__chevron-button), 
  :global(.sx__today-button) {
    color: #9ca3af !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    background: transparent !important;
    border-radius: 0.5rem !important;
  }

  :global(.sx__chevron-button:hover), 
  :global(.sx__today-button:hover) {
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.05) !important;
  }

  :global(.sx__event-modal) {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    margin: 0 !important;
    z-index: 99999 !important;
    width: 90% !important;
    max-width: 420px !important;
    background-color: rgba(20, 20, 30, 0.96) !important;
    backdrop-filter: blur(24px) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 1rem !important;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 20px rgba(255, 255, 255, 0.03) !important;
    color: #ffffff !important;
  }

  :global(.sx__event-modal::before),
  :global(.sx__event-modal::after) {
    display: none !important;
  }
</style>

<style is:global>
  #schedule-x-calendar *::-webkit-scrollbar,
  #schedule-x-calendar .sx__time-grid-scroll-container::-webkit-scrollbar {
    width: 6px !important;
    height: 6px !important;
  }

  #schedule-x-calendar *::-webkit-scrollbar-track,
  #schedule-x-calendar .sx__time-grid-scroll-container::-webkit-scrollbar-track {
    background: transparent !important;
  }

  #schedule-x-calendar *::-webkit-scrollbar-thumb,
  #schedule-x-calendar .sx__time-grid-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15) !important;
    border-radius: 9999px !important;
  }

  #schedule-x-calendar *::-webkit-scrollbar-thumb:hover,
  #schedule-x-calendar .sx__time-grid-scroll-container::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3) !important;
  }

  #schedule-x-calendar *,
  #schedule-x-calendar .sx__time-grid-scroll-container {
    scrollbar-width: thin !important;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent !important;
  }
</style>

<script>
  let calendarObserver: IntersectionObserver | null = null;
  let activeResizeListener: (() => void) | null = null;

  function initCalendar() {
    if (calendarObserver) {
      calendarObserver.disconnect();
      calendarObserver = null;
    }
    if (activeResizeListener) {
      window.removeEventListener("resize", activeResizeListener);
      activeResizeListener = null;
    }

    const container = document.getElementById("schedule-x-calendar");
    if (!container || container.dataset.rendered === "true") return;

    const endpoint = container.dataset.endpoint || "/api/google-calendar-events";
    const calendarId = container.dataset.calendarId;
    const viewMode = container.dataset.viewMode || "week";

    const fetchUrl = calendarId 
      ? `${endpoint}?calendarId=${encodeURIComponent(calendarId)}` 
      : endpoint;

    calendarObserver = new IntersectionObserver(async (entries, obs) => {
      if (entries[0].isIntersecting) {
        obs.disconnect();
        container.dataset.rendered = "true";

        try {
          const [
            _, 
            { createCalendar, viewMonthGrid, viewMonthAgenda, viewWeek, viewDay }, 
            { createEventsServicePlugin }, 
            { createEventModalPlugin },
            { createCalendarControlsPlugin },
            { createScrollControllerPlugin },
            apiResponse
          ] = await Promise.all([
            import("temporal-polyfill/global"),
            import("@schedule-x/calendar"),
            import("@schedule-x/events-service"),
            import("@schedule-x/event-modal"),
            import("@schedule-x/calendar-controls"),
            import("@schedule-x/scroll-controller"),
            fetch(fetchUrl).catch(() => null)
          ]);

          const eventsService = createEventsServicePlugin();
          const eventModal = createEventModalPlugin();
          const calendarControls = createCalendarControlsPlugin();
          
          const scrollController = createScrollControllerPlugin({
            initialScroll: '07:30'
          });

          const desktopView = viewMode === "week" ? viewWeek.name : viewMonthGrid.name;
          const mobileView = viewMode === "week" ? viewDay.name : viewMonthAgenda.name;
          
          const isMobileInitial = window.innerWidth < 768;
          const defaultView = isMobileInitial ? mobileView : desktopView;

          const selectedViews = viewMode === "week" 
            ? [viewWeek, viewDay] 
            : [viewMonthGrid, viewMonthAgenda];

          const calendar = createCalendar({
            views: selectedViews,
            defaultView: defaultView,
            firstDayOfWeek: 7,
            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "America/Edmonton",
            isResponsive: false, // Prevent built-in layout handler collisions
            events: [],
            plugins: [eventsService, eventModal, calendarControls, scrollController], 
          });
          
          calendar.render(container);

          let currentView = defaultView;
          activeResizeListener = () => {
            if (!calendarControls.$app) return;

            const isNowMobile = window.innerWidth < 768;
            const targetView = isNowMobile ? mobileView : desktopView;
            
            if (targetView !== currentView) {
              try {
                calendarControls.setView(targetView);
                currentView = targetView;
              } catch (err) {
                console.warn("Could not switch calendar view:", err);
              }
            }
          };

          window.addEventListener("resize", activeResizeListener);

          if (apiResponse && apiResponse.ok) {
            const data = await apiResponse.json();
            const rawEvents = data.items || data;
            const formattedEvents = formatGoogleEventsForScheduleX(rawEvents);
            eventsService.set(formattedEvents);
          }
        } catch (error) {
          console.error("Error initializing lazy calendar:", error);
          container.innerHTML = `<div class="calendar-loading" style="color: #ef4444;">Failed to load calendar.</div>`;
        }
      }
    }, { rootMargin: "300px" });
    
    calendarObserver.observe(container);

    function formatGoogleEventsForScheduleX(events) {
      if (!Array.isArray(events)) return [];
      return events
        .map((event) => {
          if (!event || event.status === "cancelled") return null;

          const isAllDay = !event.start?.dateTime;
          const rawStart = isAllDay ? event.start?.date : event.start?.dateTime;
          const rawEnd = isAllDay ? event.end?.date : event.end?.dateTime;

          if (!rawStart || !rawEnd) return null;

          const toTemporal = (dateStr, timeZone, isEnd = false) => {
            if (isAllDay) {
              const plainDate = Temporal.PlainDate.from(dateStr);
              if (isEnd) {
                const startDate = Temporal.PlainDate.from(rawStart);
                const adjustedEnd = plainDate.subtract({ days: 1 });
                return Temporal.PlainDate.compare(adjustedEnd, startDate) >= 0
                  ? adjustedEnd
                  : startDate;
              }
              return plainDate;
            }

            if (dateStr.includes("[")) {
              return Temporal.ZonedDateTime.from(dateStr);
            }

            const tz = timeZone || Intl.DateTimeFormat().resolvedOptions().timeZone || "America/Edmonton";
            return Temporal.Instant.from(dateStr).toZonedDateTimeISO(tz);
          };

          try {
            return {
              id: String(event.id || Math.random()),
              title: event.summary || "Busy",
              start: toTemporal(rawStart, event.start?.timeZone, false),
              end: toTemporal(rawEnd, event.end?.timeZone, true),
              description: event.description || "",
              location: event.location || "",
            };
          } catch (err) {
            console.warn(`Skipping event "${event.summary}" due to Temporal parsing error:`, err);
            return null;
          }
        })
        .filter(Boolean);
    }
  }

  document.addEventListener("astro:page-load", initCalendar);
</script>