---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand ${className}`}>
  <img 
    src='/favicon/favicon.svg' 
    class="h-12.5 w-12.5 shrink-0" 
    width="50" 
    height="50" 
    alt="logo" 
  /> 
  <span class="text-[15px] font-semibold tracking-tight text-fg">mctr.club</span>
</a>