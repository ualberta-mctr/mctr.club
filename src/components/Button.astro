---
interface Props {
	href?: string;
	target?: string;
	class?: string;
}

const { href, target, class: className = "" } = Astro.props;

const baseStyles = "inline-flex w-fit items-center justify-center px-3 py-2 rounded-lg text-[11.5px] font-bold font-sans tracking-widest capitalize leading-none transition-all duration-300 border border-[#1c1c27] bg-[#0e0e16]/80 backdrop-blur-xl text-gray-400 hover:bg-[#1c1c27] hover:text-violet-500 hover:cursor-pointer no-underline";
---

<a 
	href={href} 
	target={target} 
	class={`${baseStyles} ${className}`.trim()}
>
	<slot />
</a>