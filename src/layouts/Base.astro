---
import '../styles/global.css';
import BaseHead from "../components/BaseHead.astro";
import SkipLink from "../components/SkipLink.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
	meta: {
		title: string;
		description?: string;
		articleDate?: string;
		ogImage?: string;
	};
}

const {
	meta: { 
		articleDate, 
		description = "Home of UAlberta Mechatronics", 
		ogImage, 
		title 
	},
} = Astro.props;
---

<html lang="en" class="dark font-serif bg-black text-neutral-400 scroll-smooth">
	<head>
		<BaseHead description={description} title={title} />
	</head>
	<body>
		<SkipLink />
		<Header />
        <main id="main" class="min-h-screen pt-23.5 min-[830px]:pt-28 max-w-[760px] mx-auto px-6 lg:px-0">
			<slot />
		</main>
		<Footer />
	</body>
</html>