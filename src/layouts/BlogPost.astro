---
import type { ImageMetadata } from "astro";
import { formatBylineDate } from "../utils/date";
import TextLayout from "./TextLayout.astro";

interface Props {
	frontmatter: {
		title: string;
		description: string;
		author?: string;
		publishDate: string;
		updatedDate?: string;
		coverImage?: { src: ImageMetadata | string; alt: string };
		tags?: string[];
		draft?: boolean;
		minutesRead?: string;
	};
}

const { frontmatter } = Astro.props;
const { author, publishDate, tags, minutesRead } = frontmatter;

const pubDate = new Date(publishDate);
const bylineDate = formatBylineDate(pubDate);
const readingTime = minutesRead ?? "";
---

<TextLayout frontmatter={frontmatter}>
	<span slot="eyebrow-prefix">Updates</span>

	<div slot="after-title">
		<p class="byline">
			{author && <>By {author}<span class="sep">·</span></>}{bylineDate}{readingTime && (
				<>
					<span class="sep">·</span>{readingTime}
				</>
			)}
		</p>

		{!!tags?.length && (
			<div class="post-tags">
				{tags.map((tag, i) => (
					<>
						<span data-pagefind-filter="tag">{tag}</span>{i < tags.length - 1 && <span class="sep">·</span>}
					</>
				))}
			</div>
		)}
	</div>

	<slot />
</TextLayout>