---
import "../styles/global.css";
import Fluid from "../components/Fluid.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import SkipLink from "../components/SkipLink.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Home of UAlberta Mechatronics" } = Astro.props;
---

<html lang="en" class="dark font-serif bg-black text-neutral-400" >
    <BaseHead title={title} description={description} />
    <body>
        <SkipLink />
        <div class="fixed inset-0 z-[-1]">
            <Fluid />
        </div>

        <div
            class="fixed inset-0 z-0 pointer-events-none bg-repeat mix-blend-multiply"
            style="background-image: url('/assets/LDR_LLL1_0.png'); background-size:200px 200px; opacity:0.06;"
            aria-hidden="true"
        >
        </div>
        <Header />
        <main
            id="main"
            class="min-h-screen pt-23.5 min-[830px]:pt-28"
        >
            <slot />
        </main>
        <Footer />
    </body>
</html>
